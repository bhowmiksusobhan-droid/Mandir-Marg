{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mandir-marg",
  "compatibility_date": "2026-11-17",
  "main": "src/worker.js",

  // The site itself: index.html, css, js, icons, sw.js, manifest, _headers.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Send /api/* to src/worker.js; every other request is served straight
    // from the edge as a static asset.
    "run_worker_first": ["/api/*"]
  },

  "observability": {
    "enabled": true
  }
}
